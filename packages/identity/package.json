{
  "name": "@jcurve/identity",
  "version": "1.1.0",
  "description": "리워드 앱 공용 간편인증(KICA) 본인확인 — 앱(@jcurve/identity) · 자체 서버 Node(@jcurve/identity/server)",
  "main": "dist/index.js",
